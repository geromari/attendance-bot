# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin Telegram IDs (comma-separated, e.g. 12345678,87654321)
ADMIN_IDS=your_telegram_id_here

# Work Location GPS Coordinates
WORK_LOCATION_LAT=41.338938
WORK_LOCATION_LNG=69.337057

# Work Attendance Rules
MAX_DISTANCE_METERS=100
DAILY_HOUR_LIMIT=5

# Database URL (SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./attendance.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/attendance_db
